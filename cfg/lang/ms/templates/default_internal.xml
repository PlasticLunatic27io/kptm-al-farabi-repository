<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html SYSTEM "entities.dtd">

<html
  xmlns="http://www.w3.org/1999/xhtml"
  xml:lang="ms"
  lang="ms"
  xmlns:epc="http://eprints.org/ep3/control">

<head>

  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    <epc:pin ref="title" textonly="yes"/> -
    <epc:phrase ref="archive_name"/>
  </title>

  <link
    rel="icon"
    href="{$config{rel_path}}/favicon.ico"
    type="image/x-icon"
  />

  <link
    rel="stylesheet"
    type="text/css"
    href="{$config{rel_path}}/style/auto.css"
  />

  <link
    rel="stylesheet"
    type="text/css"
    href="{$config{rel_path}}/style/auto/zzz_staff.css?v=manual1"
  />

  <epc:pin ref="head"/>

</head>


<body class="kptm-staff-page">

<epc:pin ref="pagetop"/>


<div class="kptm-staff-shell">


  <!-- =====================================================
       STAFF TOP BAR
       ===================================================== -->

  <header class="kptm-staff-topbar">

    <div class="kptm-staff-brand">

      <a
        href="{$config{rel_cgipath}}/users/home"
        class="kptm-staff-brand-link">

        <span class="kptm-staff-brand-mark">
          AF
        </span>

        <span class="kptm-staff-brand-copy">

          <strong>
            Al-Farabi Repository
          </strong>

          <small>
            Staff Workspace
          </small>

        </span>

      </a>

    </div>


    <div class="kptm-staff-topbar-actions">
    <epc:pin ref="kptm_user_identity_ms"/>
      <div class="kptm-staff-language">

  <a
    href="{$config{rel_cgipath}}/set_lang?lang=en&amp;referrer={$config{base_url}}"
    class="kptm-context-language">
    EN
  </a>

  <span aria-hidden="true">/</span>

  <a
    href="{$config{rel_cgipath}}/set_lang?lang=ms&amp;referrer={$config{base_url}}"
    class="kptm-context-language is-current">
    BM
  </a>

</div>

    </div>

  </header>



  <!-- =====================================================
       APPLICATION LAYOUT
       ===================================================== -->

  <div class="kptm-staff-layout">


    <!-- ===================================================
         SIDEBAR
         =================================================== -->

    <aside
      class="kptm-staff-sidebar"
      aria-label="Staff navigation">

      <!-- ===================================================
     INTERFACE MODE
     =================================================== -->

<div class="kptm-staff-mode-control">

  <div class="kptm-staff-mode-label">
    View Mode
  </div>

  <div
    class="kptm-staff-mode-switch"
    role="group"
    aria-label="Interface mode">

    <span
      class="kptm-staff-mode-option is-active"
      aria-current="page">

      <span class="kptm-staff-mode-light"></span>

      Workspace

    </span>

    <a
      href="{$config{rel_path}}/"
      class="kptm-staff-mode-option"
      title="Switch to public repository">

      Public

    </a>

  </div>

</div>

      <nav class="kptm-staff-nav">


        <a
          href="{$config{rel_cgipath}}/users/home"
          class="kptm-staff-nav-item"
          data-kptm-screen="dashboard">

          <span class="kptm-staff-nav-icon">⌂</span>

          <span>
            Dashboard
          </span>

        </a>


        <a
          href="{$config{rel_cgipath}}/users/home?screen=NewEPrint"
          class="kptm-staff-nav-item"
          data-kptm-screen="NewEPrint">

          <span class="kptm-staff-nav-icon">＋</span>

          <span>
            New Item
          </span>

        </a>


        <a
          href="{$config{rel_cgipath}}/users/home?screen=Items"
          class="kptm-staff-nav-item"
          data-kptm-screen="Items">

          <span class="kptm-staff-nav-icon">▣</span>

          <span>
            Deposits
          </span>

        </a>


        <a
          href="{$config{rel_cgipath}}/users/home?screen=Review"
          class="kptm-staff-nav-item"
          data-kptm-screen="Review">

          <span class="kptm-staff-nav-icon">✓</span>

          <span>
            Review
          </span>

        </a>


        <a
          href="{$config{rel_cgipath}}/users/home?screen=DataSets"
          class="kptm-staff-nav-item"
          data-kptm-screen="DataSets">

          <span class="kptm-staff-nav-icon">⌕</span>

          <span>
            Manage Records
          </span>

        </a>


        <div class="kptm-staff-nav-divider"></div>


        <a
          href="{$config{rel_cgipath}}/users/home?screen=User::View"
          class="kptm-staff-nav-item"
          data-kptm-screen="User::View">

          <span class="kptm-staff-nav-icon">○</span>

          <span>
            Profile
          </span>

        </a>


        <a
          href="{$config{rel_cgipath}}/logout"
          class="kptm-staff-nav-item">

          <span class="kptm-staff-nav-icon">↪</span>

          <span>
            Logout
          </span>

        </a>


      </nav>

    </aside>



    <!-- ===================================================
         PAGE WORKSPACE
         =================================================== -->

    <main
      id="main_content"
      class="kptm-staff-content">


      <div class="kptm-staff-page-heading">

        <h1
          id="page-title"
          class="ep_tm_pagetitle">

          <epc:pin ref="title"/>

        </h1>

      </div>


      <div class="kptm-staff-workspace">

        <epc:pin ref="page"/>

      </div>


    </main>


  </div>

</div>



<!-- =====================================================
     CURRENT SIDEBAR LOCATION
     ===================================================== -->

<script type="text/javascript">
// <![CDATA[

document.addEventListener("DOMContentLoaded", function () {

    var params =
        new URLSearchParams(window.location.search);

    var screen =
        params.get("screen") || "dashboard";

    var links =
        document.querySelectorAll(
            ".kptm-staff-nav-item[data-kptm-screen]"
        );

    links.forEach(function (link) {

        var target =
            link.getAttribute("data-kptm-screen");

        var active = false;


        if (
            target === "dashboard" &&
            screen === "dashboard"
        ) {
            active = true;
        }


        if (
            target !== "dashboard" &&
            (
                screen === target ||
                screen.indexOf(target + "::") === 0
            )
        ) {
            active = true;
        }


        if (active) {
            link.classList.add("is-active");
        }

    });

});

// ]]>
</script>

<script type="text/javascript">
// <![CDATA[

document.addEventListener("DOMContentLoaded", function () {

    document
        .querySelectorAll(".kptm-context-language")
        .forEach(function (link) {

            link.addEventListener("click", function (event) {

                event.preventDefault();

                var destination =
                    new URL(link.href, window.location.href);

                /*
                 * Preserve the EXACT staff page:
                 *
                 * /cgi/users/home?screen=Items
                 * /cgi/users/home?screen=Review
                 * /cgi/users/home?screen=DataSets
                 * etc.
                 */
                destination.searchParams.set(
                    "referrer",
                    window.location.href
                );

                window.location.href =
                    destination.toString();

            });

        });

});

// ]]>
</script>

</body>

</html>
